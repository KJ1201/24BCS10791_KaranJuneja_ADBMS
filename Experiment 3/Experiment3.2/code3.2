SELECT emp_city, COUNT(*) AS cnt
FROM employees
GROUP BY emp_city;

SELECT emp_city, COUNT(emp_id) AS cnt
FROM employees
GROUP BY emp_city;

SELECT emp_city,
       SUM(CASE WHEN emp_salary >= 90000 THEN 1 ELSE 0 END) AS cnt
FROM employees
GROUP BY emp_city;

SELECT emp_city,
       SUM(CASE WHEN emp_salary >= 90000 THEN 1 ELSE 0 END) AS cnt
FROM employees
GROUP BY emp_city
ORDER BY emp_city DESC;

SELECT emp_city,
       SUM(CASE WHEN emp_salary >= 90000 THEN 1 ELSE 0 END) AS cnt
FROM employees
GROUP BY emp_city
ORDER BY cnt DESC, emp_city DESC;

SELECT emp_city
FROM employees
GROUP BY emp_city
HAVING COUNT(emp_id) >= 2;

SELECT DISTINCT emp_city
FROM employees;